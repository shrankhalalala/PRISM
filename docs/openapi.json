{
  "openapi": "3.1.0",
  "info": {
    "title": "PRISM Phase 2 API",
    "version": "0.2.0",
    "description": "Completed Phase 2 synthetic prototype with three forecast methods, constrained scenarios, and non-executable Q-learning recommendations. No operational switching. Phase 3 increment: read-only Delhi SLDC public measurements with freshness metadata."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:5050"
    }
  ],
  "paths": {
    "/api/live/gridwatch": {
      "get": {
        "summary": "Latest Delhi SLDC reading, cached for 60 seconds per application process",
        "description": "Read-only public-source adapter. Synthetic model and scenario endpoints remain separate. Records older than 300 seconds, or retained after a fetch failure, are stale. Cache is in memory; this endpoint does not build historical training data.",
        "responses": {
          "200": {
            "description": "Live or stale last-good reading",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GridWatchSnapshot"
                }
              }
            }
          },
          "503": {
            "description": "No valid source reading available",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GridWatchSnapshot"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "summary": "Liveness; does not check external service readiness",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "const": "ok"
                    },
                    "phase": {
                      "const": 2
                    },
                    "data_source": {
                      "const": "synthetic"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Fixture unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/status": {
      "get": {
        "summary": "Phase and module implementation status",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "phase": {
                      "type": "integer"
                    },
                    "modules": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "name",
                          "status",
                          "description"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "status": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Fixture unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/grid": {
      "get": {
        "summary": "Validated fictional topology; no power-flow results",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data_source": {
                      "const": "synthetic"
                    },
                    "nodes": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Node"
                      }
                    },
                    "edges": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Edge"
                      }
                    },
                    "summary": {
                      "type": "object",
                      "properties": {
                        "nodes": {
                          "type": "number"
                        },
                        "edges": {
                          "type": "number"
                        },
                        "generation_mw": {
                          "type": "number"
                        },
                        "demand_mw": {
                          "type": "number"
                        },
                        "balance_mw": {
                          "type": "number"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Fixture unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/measurements": {
      "get": {
        "summary": "Latest synthetic historical rows",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data_source": {
                      "const": "synthetic"
                    },
                    "count": {
                      "type": "integer"
                    },
                    "records": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Measurement"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Fixture unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2160,
              "default": 24
            }
          }
        ]
      }
    },
    "/api/data/quality": {
      "get": {
        "summary": "Audit counts may overlap by rejection reason",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "input_rows": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "accepted_rows": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "rejected_rows": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "imputed_rows": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "reasons": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "integer"
                      }
                    },
                    "gaps": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "cadence": {
                      "const": "hourly"
                    },
                    "timezone": {
                      "const": "UTC"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Fixture unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/dispatch/baseline": {
      "get": {
        "summary": "Preview only; aggregate reserve check does not establish electrical feasibility",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Baseline"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Fixture unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Preview only; aggregate reserve check does not establish electrical feasibility",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Baseline"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Fixture unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Observation"
              }
            }
          }
        }
      }
    },
    "/api/forecast": {
      "get": {
        "summary": "Generate a synthetic persistence, autoregressive, or LSTM forecast",
        "parameters": [
          {
            "name": "target",
            "in": "query",
            "schema": {
              "enum": [
                "demand_mw",
                "solar_mw",
                "wind_mw"
              ],
              "default": "demand_mw"
            }
          },
          {
            "name": "model",
            "in": "query",
            "schema": {
              "enum": [
                "persistence",
                "autoregressive",
                "lstm"
              ],
              "default": "persistence"
            }
          },
          {
            "name": "horizon",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 24,
              "default": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Synthetic development forecast",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid forecast query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/dispatch": {
      "post": {
        "summary": "Return a non-executable recommendation from the reviewed Phase 2 Q-table",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "demand_mw",
                  "generation_mw",
                  "reserve_mw"
                ],
                "properties": {
                  "demand_mw": {
                    "type": "number",
                    "minimum": 0
                  },
                  "generation_mw": {
                    "type": "number",
                    "minimum": 0
                  },
                  "reserve_mw": {
                    "type": "number",
                    "minimum": 0
                  },
                  "battery_soc": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1,
                    "default": 0.5
                  },
                  "renewable_trend": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1,
                    "default": 0
                  },
                  "fault_present": {
                    "type": "boolean",
                    "default": false
                  },
                  "valid_actions": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/Action"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Synthetic recommendation with executable=false",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid observation or action mask",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/explain": {
      "post": {
        "summary": "Actual surrogate TreeSHAP attribution with policy-agreement boundary",
        "responses": {
          "200": {
            "description": "100-background raw-score attribution"
          },
          "400": {
            "description": "Invalid observation/mask"
          },
          "503": {
            "description": "Explanation model unavailable"
          }
        }
      }
    },
    "/api/scenario": {
      "post": {
        "summary": "Run a deterministic constrained synthetic scenario",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "steps": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 96,
                    "default": 8
                  },
                  "seed": {
                    "type": "integer",
                    "default": 42
                  },
                  "actions": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "hold",
                        "increase_generation",
                        "decrease_generation",
                        "charge_battery",
                        "discharge_battery",
                        "shed_load"
                      ]
                    }
                  },
                  "policy": {
                    "enum": [
                      "baseline",
                      "q_learning"
                    ],
                    "default": "baseline",
                    "description": "Cannot be combined with actions."
                  },
                  "faults": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "step",
                        "asset_id"
                      ],
                      "properties": {
                        "step": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "asset_id": {
                          "type": "string"
                        },
                        "duration_steps": {
                          "type": "integer",
                          "minimum": 1,
                          "default": 4
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Scenario trajectory and aggregate metrics",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid scenario",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "JSON required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/openapi.json": {
      "get": {
        "summary": "This OpenAPI document",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Fixture unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/reference-grid": {
      "get": {
        "summary": "Complete source-dated Delhi reference topology; independent of simulation and database availability",
        "description": "Returns every canonical asset, circuit observation and interface assertion with deterministic schematic positions, provenance and explicit unknowns. ETag supports immutable content-version caching.",
        "responses": {
          "200": {
            "description": "Reference inventory"
          },
          "304": {
            "description": "Unchanged reference version"
          },
          "503": {
            "description": "Reviewed export unavailable or invalid"
          }
        }
      }
    },
    "/api/reference-grid/assets/{identifier}": {
      "get": {
        "summary": "Inspect one canonical reference asset and all connected evidence",
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Asset, connected observations and source locators"
          },
          "404": {
            "description": "Unknown reference asset"
          },
          "503": {
            "description": "Reference export unavailable"
          }
        }
      }
    },
    "/api/live/stations": {
      "get": {
        "summary": "Source-qualified station loading with freshness and mapping coverage",
        "responses": {
          "200": {
            "description": "Source-qualified data or explicit unavailable asset measurement"
          },
          "503": {
            "description": "Source or reference export unavailable"
          }
        }
      }
    },
    "/api/live/assets/{identifier}": {
      "get": {
        "summary": "Eligible station measurement for a reference asset",
        "responses": {
          "200": {
            "description": "Source-qualified data or explicit unavailable asset measurement"
          },
          "503": {
            "description": "Source or reference export unavailable"
          }
        },
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/ingestion/health": {
      "get": {
        "summary": "Durable ingestion health",
        "responses": {
          "200": {
            "description": "Durable service result"
          },
          "503": {
            "description": "Infrastructure unavailable"
          }
        }
      }
    },
    "/api/history/{asset_id}": {
      "get": {
        "summary": "Immutable durable event history",
        "responses": {
          "200": {
            "description": "Durable service result"
          },
          "503": {
            "description": "Infrastructure unavailable"
          }
        },
        "parameters": [
          {
            "name": "asset_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          }
        ]
      }
    },
    "/api/forecast/real": {
      "get": {
        "summary": "Audited real Delhi demand 24-hour forecasts with explicit age and source eligibility",
        "responses": {
          "200": {
            "description": "24-hour historical/recent preview with provenance"
          },
          "422": {
            "description": "Real renewable history unavailable"
          },
          "503": {
            "description": "History/model artifact or complete input unavailable"
          }
        }
      }
    },
    "/api/dispatch/surrogate": {
      "post": {
        "summary": "Advisory six-action surrogate, Q-policy fidelity, masks and provenance",
        "responses": {
          "200": {
            "description": "Advisory comparison, uncalibrated scores and abstention"
          },
          "400": {
            "description": "Invalid observation or action mask"
          },
          "503": {
            "description": "Model/dependencies unavailable"
          }
        }
      }
    },
    "/api/diagnose": {
      "post": {
        "summary": "Topology/time investigation hypotheses, not verified physical causes",
