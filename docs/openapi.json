          },
          "503": {
            "description": "Operations infrastructure unavailable"
          }
        },
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/advisories": {
      "post": {
        "summary": "Persist a supplied synthetic-policy advisory and explanation",
        "responses": {
          "201": {
            "description": "Advisory workflow result"
          },
          "503": {
            "description": "Operations infrastructure unavailable"
          }
        }
      }
    },
    "/api/advisories/{identifier}/decisions": {
      "get": {
        "summary": "Read immutable advisory decision records",
        "responses": {
          "200": {
            "description": "Advisory workflow result"
          },
          "503": {
            "description": "Operations infrastructure unavailable"
          }
        },
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      },
      "post": {
        "summary": "Append an advisory accept/override with operator and reason; no control command",
        "parameters": [
          {
            "name": "identifier",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Decision recorded"
          },
          "401": {
            "description": "Operator token required"
          },
          "400": {
            "description": "Invalid decision"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GridWatchSnapshot": {
        "type": "object",
        "required": [
          "data_source",
          "source_url",
          "feed_url",
          "status",
          "reading",
          "fetched_at",
          "checked_at",
          "age_seconds",
          "refresh_seconds",
          "stale_after_seconds",
          "error"
        ],
        "properties": {
          "data_source": {
            "const": "delhi_sldc"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "feed_url": {
            "type": "string",
            "format": "uri"
          },
          "status": {
            "enum": [
              "live",
              "stale",
              "unavailable"
            ]
          },
          "reading": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "observed_at",
                  "demand_mw",
                  "frequency_hz",
                  "drawal_mw",
                  "schedule_mw"
                ],
                "properties": {
                  "observed_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "demand_mw": {
                    "type": "number",
                    "minimum": 0
                  },
                  "frequency_hz": {
                    "type": "number",
                    "minimum": 0
                  },
                  "drawal_mw": {
                    "type": "number",
                    "minimum": 0
                  },
                  "schedule_mw": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            ]
          },
          "fetched_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "checked_at": {
            "type": "string",
            "format": "date-time"
          },
          "age_seconds": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "refresh_seconds": {
            "const": 60
          },
          "stale_after_seconds": {
            "const": 300
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Action": {
        "type": "string",
        "enum": [
          "hold",
          "increase_generation",
          "decrease_generation",
          "charge_battery",
          "discharge_battery",
          "shed_load"
        ]
      },
      "Observation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "demand_mw",
          "generation_mw",
          "reserve_mw"
        ],
        "properties": {
          "demand_mw": {
            "type": "number",
            "minimum": 0
          },
          "generation_mw": {
            "type": "number",
            "minimum": 0
          },
          "reserve_mw": {
            "type": "number",
            "minimum": 0
          },
          "battery_soc": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.5
          },
          "renewable_trend": {
            "type": "number",
            "minimum": -1,
            "maximum": 1,
            "default": 0
          },
          "fault_present": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "Node": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "name",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "plant",
              "substation",
              "load"
            ]
          },
          "name": {
            "type": "string"
          },
          "status": {
            "enum": [
              "online",
              "offline"
            ]
          },
          "capacity_mw": {
            "type": "number",
            "minimum": 0
          },
          "output_mw": {
            "type": "number",
            "minimum": 0
          },
          "demand_mw": {
            "type": "number",
            "minimum": 0
          },
          "voltage_kv": {
            "type": "number",
            "minimum": 0
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        }
      },
      "Edge": {
        "type": "object",
        "required": [
          "id",
          "source",
          "target",
          "capacity_mw",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "capacity_mw": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "Measurement": {
        "type": "object",
        "required": [
          "timestamp",
          "demand_mw",
          "solar_mw",
          "wind_mw",
          "frequency_hz",
          "source",
          "quality_flag"
        ],
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "demand_mw": {
            "type": "number",
            "minimum": 0
          },
          "solar_mw": {
            "type": "number",
            "minimum": 0
          },
          "wind_mw": {
            "type": "number",
            "minimum": 0
          },
          "frequency_hz": {
            "type": "number"
          },
          "source": {
            "type": "string"
          },
          "quality_flag": {
            "type": "string"
          }
        }
      },
      "Baseline": {
        "type": "object",
        "required": [
          "action",
          "requested_mw",
          "executable",
          "feasibility_scope"
        ],
        "properties": {
          "action": {
            "enum": [
              "hold",
              "increase_generation",
              "decrease_generation",
              "charge_battery",
              "discharge_battery",
              "shed_load"
            ]
          },
          "policy": {
            "const": "rule_based_prototype"
          },
          "requested_mw": {
            "type": "number",
            "minimum": 0
          },
          "unmet_gap_mw": {
            "type": "number",
            "minimum": 0
          },
          "reason": {
            "type": "string"
          },
          "feasible": {
            "type": "boolean"
          },
          "executable": {
            "const": false
          },
          "feasibility_scope": {
            "const": "aggregate_reserve_only"
          },
          "encoded_state": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 5,
            "maxItems": 5
          },
          "data_source": {
            "enum": [
              "synthetic",
              "user_supplied"
            ]
          }
        }
      }
    }
  }
}
