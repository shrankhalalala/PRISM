            "description": "Ranked hypotheses with evidence paths and timing/convergence limits"
          },
          "400": {
            "description": "Invalid alarms or dataset"
          }
        }
      }
    },
    "/api/operations/health": {
      "get": {
        "summary": "Redis/PostgreSQL/worker health",
