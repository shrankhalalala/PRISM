# Docker Compose automatically reads .env. Copy this file and replace the secrets.
# Keep existing database passwords when reusing volumes.
NEO4J_PASSWORD=replace-with-a-strong-local-password
POSTGRES_PASSWORD=replace-with-a-strong-local-password
PRISM_OPERATOR_TOKEN=replace-with-a-long-random-operator-token

# python -m prism loads this file automatically (local web: port 5051).
# Host-side research/verification scripts still need exported shell variables.
# The web container sets its own URLs using Docker service names.
PRISM_BASE_URL=http://127.0.0.1:5050
PRISM_DATABASE_URL=postgresql://prism:${POSTGRES_PASSWORD}@127.0.0.1:5433/prism
PRISM_REDIS_URL=redis://127.0.0.1:6380/0
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
